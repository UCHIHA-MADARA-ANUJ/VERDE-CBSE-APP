# Copy to .env.local and fill in. NEVER commit real values.
# These are read on the server only (app/api/*). They are never sent to the browser.

# Firebase Realtime Database
FIREBASE_DB_HOST=verde-tech-haha-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DB_SECRET=

# Google Gemini (image chat). Model defaults to gemini-flash-latest.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest

# OpenWeather (current weather + 5-day forecast for Delhi)
OPENWEATHER_API_KEY=

# OpenRouter (sensor-aware chat). Model defaults to openai/gpt-4o-mini.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# Crop.health / Plant.id identification
PLANTID_API_KEY=
